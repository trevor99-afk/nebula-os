# NebulaOS build settings. This is the one file to edit.

# Image name on the registry. Use the same name for your GitHub repository.
IMAGE_NAME=nebula-os

# Name shown in the boot menu, Settings > About and the terminal welcome message.
IMAGE_PRETTY_NAME="NebulaOS"

# Your GitHub username (or organisation). Images are published to
# ghcr.io/<REPO_ORGANIZATION>/<IMAGE_NAME>, and installed systems update from there.
REPO_ORGANIZATION="trevor99-afk"

# The Bazzite edition to build on (see "Editions" in README.md):
#   ghcr.io/ublue-os/bazzite-dx-gnome:stable         two sides: Steam Gaming Mode + GNOME work desktop with dev tools (default)
#   ghcr.io/ublue-os/bazzite-dx-nvidia-gnome:stable  the same for NVIDIA GPUs
#   ghcr.io/ublue-os/bazzite-gnome:stable            GNOME desktop only, no Gaming Mode and no dev tools
BASE_IMAGE="ghcr.io/ublue-os/bazzite-dx-gnome:stable"

IMAGE_DESC="NebulaOS: a gaming-focused Linux distribution built on Bazzite"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,bazzite"

# Optional: logo for an https://artifacthub.io listing.
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
