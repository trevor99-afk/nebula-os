# NebulaOS default wallpaper. Sorts after Bazzite's zz0-* overrides, so it wins.
# Only changes the default: wallpapers people pick themselves are kept.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/nebula-os/nebula-day.svg'
picture-uri-dark='file:///usr/share/backgrounds/nebula-os/nebula-night.svg'
picture-options='zoom'
primary-color='#0d0724'

# Dock for Work Mode: Bazaar and Bazzite Portal (app installation), VS Code, Terminal and
# Files, Steam and Lutris, plus a shortcut to Gaming Mode. 90-finalize.sh checks every entry.
[org.gnome.shell]
favorite-apps=['org.mozilla.firefox.desktop', 'io.github.kolunmi.Bazaar.desktop', 'io.github.ublue_os.yafti_gtk.desktop', 'com.microsoft.VSCode.desktop', 'org.gnome.Ptyxis.desktop', 'org.gnome.Nautilus.desktop', 'steam.desktop', 'net.lutris.Lutris.desktop', 'nebula-os-switch-to-gaming.desktop']

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/nebula-os/nebula-night.svg'
picture-options='zoom'
primary-color='#0d0724'
