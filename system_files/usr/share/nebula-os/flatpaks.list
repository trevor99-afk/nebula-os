# NebulaOS app bundle: Flatpaks installed system-wide from Flathub on first boot.
#
# One Flathub app ID per line; everything after # is a comment.
# Find IDs at https://flathub.org (the ID is the last part of an app's URL).
# Apps a user uninstalls are never reinstalled automatically.
#
# Bazzite already ships Steam, Lutris and Protontricks; ProtonPlus and more are one click
# away in Bazzite Portal. Apps a user installed per-user are not installed twice.

# Everyday apps. Bazzite's own installer adds these from the ISO; the NebulaOS
# installer does not, so without them a fresh install has no web browser
# (found in a GNOME Boxes install, 2026-11-22). Listed first so they arrive first.
org.mozilla.firefox             # Firefox: web browser (pinned in the dock)
org.gnome.TextEditor            # Text Editor
org.gnome.Calculator            # Calculator
org.gnome.Loupe                 # Image Viewer
org.gnome.Papers                # Document Viewer (PDF)
com.github.tchx84.Flatseal      # Flatseal: app permissions
com.mattjakeman.ExtensionManager  # Extension Manager: GNOME extensions

# Game launchers
com.heroicgameslauncher.hgl     # Heroic Games Launcher: Epic, GOG and Amazon games
com.usebottles.bottles          # Bottles: run Windows apps and games

# Streaming & chat
com.obsproject.Studio           # OBS Studio: record and stream gameplay
dev.vencord.Vesktop             # Vesktop: Discord client with screen-share audio

# Performance tools
io.github.radiolamp.mangojuice  # MangoJuice: set up the MangoHud FPS overlay

# Emulators
org.libretro.RetroArch          # RetroArch: retro consoles
org.DolphinEmu.dolphin-emu      # Dolphin: GameCube and Wii
net.pcsx2.PCSX2                 # PCSX2: PlayStation 2
