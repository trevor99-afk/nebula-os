#!/usr/bin/bash
# Switch between the two modes of NebulaOS:
#   gaming  NebulaOS Gaming Mode: Steam Gaming Mode (full screen, controller friendly)
#   work    NebulaOS Work Mode: GNOME desktop with the developer tools and Bazaar
#
# Usage: nebula-os-switch-side gaming|work|status [--now]
#        nebula-os-switch-side chooser on|off
#   Without --now, only the mode pre-selected at the next login changes.
#   With --now, you are also logged out so you can sign in to that mode. From a
#   text console or SSH, --now closes your graphical session (for example a
#   Gaming Mode stuck on a black screen) instead of the console session.
#   status prints gaming, work or chooser.
#   chooser on: show the full-screen mode chooser after every login (the
#   "NebulaOS" session, /usr/libexec/nebula-os-start); off: start the last mode
#   directly again.
#
# The choice is stored with AccountsService, which the login screen (GDM)
# reads to pre-select the session. No password is needed for your own account.
# With the chooser on, AccountsService keeps the chooser session, and gaming or
# work becomes a one-time choice (~/.local/state/nebula-os/next-mode): the
# next start skips the chooser once. Inside the chooser session, --now ends the
# current mode and the chooser session starts the other one without a new login.
set -euo pipefail

GAMING_SESSION="gamescope-session-steam"
WORK_SESSION="gnome"
CHOOSER_SESSION="nebula-os"
USER_PATH="/org/freedesktop/Accounts/User$(id -u)"

current_session() {
    busctl get-property org.freedesktop.Accounts "$USER_PATH" org.freedesktop.Accounts.User Session \
        | awk '{print $2}' | tr -d '"'
}

set_session() {
    busctl call org.freedesktop.Accounts "$USER_PATH" org.freedesktop.Accounts.User SetSession s "$1"
    busctl call org.freedesktop.Accounts "$USER_PATH" org.freedesktop.Accounts.User SetSessionType s wayland
}

state_dir() { echo "${XDG_STATE_HOME:-${HOME:?HOME is not set}/.local/state}/nebula-os"; }

# remember FILE MODE: write a mode to a state file (never through a symbolic link).
remember() {
    local dir file
    dir=$(state_dir)
    file="$dir/$1"
    mkdir -p "$dir"
    if [[ -L "$file" || -L "$file.tmp" ]]; then
        echo "Refusing to write $file: it is a symbolic link." >&2
        exit 1
    fi
    printf '%s\n' "$2" >"$file.tmp"
    mv -f "$file.tmp" "$file"
}

side="${1:-}"
case "$side" in
    gaming) session="$GAMING_SESSION" ;;
    work) session="$WORK_SESSION" ;;
    chooser)
        case "${2:-}" in
            on)
                set_session "$CHOOSER_SESSION"
                echo "The full-screen mode chooser will appear after you log in."
                ;;
            off)
                last=$(cat "$(state_dir)/last-mode" 2>/dev/null || true)
                if [[ "$last" == gaming ]]; then set_session "$GAMING_SESSION"; else set_session "$WORK_SESSION"; last=work; fi
                echo "The mode chooser is off; NebulaOS $([[ $last == gaming ]] && echo Gaming || echo Work) Mode will start after you log in."
                ;;
            *)
                echo "Usage: ${0##*/} chooser on|off" >&2
                exit 2
                ;;
        esac
        exit 0
        ;;
    status)
        if ! current=$(current_session); then
            echo "Could not read the login mode from AccountsService." >&2
            exit 1
        fi
        case "$current" in
            # Steam Gaming Mode, plain or with the OpenGamepadUI overlay.
            gamescope-session*) echo "gaming" ;;
            # GNOME. No saved session yet: GDM falls back to the "gnome" session.
            gnome | gnome-wayland | gnome-xorg | "") echo "work" ;;
            # The full-screen chooser after login (the "NebulaOS" session).
            "$CHOOSER_SESSION") echo "chooser" ;;
            *)
                echo "The saved login session \"$current\" is neither NebulaOS Gaming Mode nor Work Mode." >&2
                exit 1
                ;;
        esac
        exit 0
        ;;
    *)
        echo "Usage: ${0##*/} gaming|work|status [--now] | chooser on|off" >&2
        exit 2
        ;;
esac

label="NebulaOS $([[ $side == gaming ]] && echo "Gaming" || echo "Work") Mode"
if current=$(current_session 2>/dev/null) && [[ "$current" == "$CHOOSER_SESSION" ]]; then
    # Keep the chooser; skip it once for this mode.
    remember next-mode "$side"
    remember last-mode "$side"
    when="will start next, without the mode chooser (just this once)"
else
    set_session "$session"
    when="will be selected at your next login"
fi

if [[ "${2:-}" != "--now" ]]; then
    echo "$label $when."
    exit 0
fi

# graphical_sessions: IDs of this user's local Wayland/X11 sessions (Gaming or Work
# Mode). Remote sessions (for example GNOME Remote Login) are left alone. Fails if
# logind cannot list the sessions.
graphical_sessions() {
    local list id uid _rest type remote
    list=$(loginctl list-sessions --no-legend) || return 1
    while read -r id uid _rest; do
        [[ -n "$id" && "$uid" == "$(id -u)" ]] || continue
        type=$(loginctl show-session "$id" -p Type --value 2>/dev/null) || continue
        remote=$(loginctl show-session "$id" -p Remote --value 2>/dev/null) || remote=no
        if [[ ("$type" == wayland || "$type" == x11) && "$remote" != yes ]]; then echo "$id"; fi
    done <<<"$list"
}

# Leave the graphical session; the login screen then offers the chosen mode.
if [[ "${XDG_SESSION_TYPE:-}" == wayland || "${XDG_SESSION_TYPE:-}" == x11 ]]; then
    # Running inside the session: the dock launcher, Steam's "Switch to Desktop",
    # or Bazzite's recovery after failed Gaming Mode starts.
    if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
        gnome-session-quit --logout --no-prompt
    elif pgrep -u "$(id -u)" -x steam >/dev/null; then
        steam -shutdown
    elif [[ -n "${XDG_SESSION_ID:-}" ]]; then
        loginctl terminate-session "$XDG_SESSION_ID"
    else
        echo "$label is selected. Log out to switch."
    fi
else
    # From a text console (Ctrl+Alt+F3) or SSH, for example when Gaming Mode shows a
    # black screen: end the graphical session, not this console's own session.
    if ! sessions=$(graphical_sessions); then
        echo "$label is selected, but the running sessions could not be listed, so none was closed." >&2
        echo "Log out of the graphical session, or restart, to switch." >&2
        exit 1
    fi
    if [[ -n "$sessions" ]]; then
        for id in $sessions; do loginctl terminate-session "$id"; done
        echo "$label is selected. The graphical session was closed; log in again on the login screen."
    else
        echo "$label is selected and will start at your next login."
    fi
fi
